# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# terraform fmt uses two spaces; keep editors in agreement with it.
[*.{tf,tfvars,hcl}]
indent_size = 2

[*.md]
max_line_length = off
trim_trailing_whitespace = false
